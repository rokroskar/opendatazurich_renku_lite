{
  "jupyter-lite-schema-version": 0,
  "jupyter-config-data": {
    "appName": "OpenDataZurich Lite",
    "defaultKernelName": "python",
    "litePluginSettings": {
      "@jupyterlite/pyodide-kernel-extension:kernel": {
        "loadPyodideOptions": {
          "packages": [
            "pyarrow",
            "pandas",
            "matplotlib",
            "scipy",
            "/pypi/opendata_lite-1.0.0-py3-none-any.whl",
            "/pypi/seaborn-0.13.2-py3-none-any.whl"
          ]
        }
      }
    }
  }
}
